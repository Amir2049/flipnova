+void TeamAIController::ApplyCounterPress() {
+  DO_VALIDATION;
+  Player *opp = match->GetTeam(abs(team->GetID() - 1))->GetBestPossessionPlayer();
+  if (!opp) return;
+  counterPressActive = true;
+  counterPressEndTime_ms = match->GetActualTime_ms() + 3500;
+  counterPressTarget = opp;
+  counterPressPlayers.clear();
+  Vector3 ballPos = match->GetBall()->Predict(0).Get2D();
+  std::vector<Player*> players;
+  team->GetActivePlayers(players);
+  // the two nearest outfield players (a third would leave too much open behind them)
+  for (int n = 0; n < 2; n++) {
+    Player *best = 0;
+    float bestD = 1e9f;
+    for (Player *p : players) {
+      if (p == team->GetGoalie()) continue;
+      if (p->ExternalControllerActive()) continue;   // the human's own player
+      if (std::find(counterPressPlayers.begin(), counterPressPlayers.end(), p) != counterPressPlayers.end()) continue;
+      float d = (p->GetPosition() - ballPos).GetLength();
+      if (d < bestD) { bestD = d; best = p; }
+    }
+    if (best && bestD < 18.0f) {
+      best->SetManMarking(opp);
+      counterPressPlayers.push_back(best);
+    }
+  }
+}
