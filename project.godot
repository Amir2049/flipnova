config_version=5

[application]
config/project_settings_override="user://override.cfg"
config/name="AFC"
run/main_scene="res://scenes/boot.tscn"
config/version="2.18"
config/quit_on_go_back=false
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Profile="*res://scripts/data/profile.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Changa-AFC.ttf"
theme/default_font_antialiasing=1

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true

[debug]

file_logging/enable_file_logging=true
